# ── AI authoring (optional) ───────────────────────────────────────────────
# Without either key below, the studio still works; you just write scene
# names, narration, and alt-text by hand instead of having AI draft them.
#
# Anthropic is used whenever this is set (recommended — the app is tuned for
# it: JSON-schema constrained output, better vision quality on distorted
# equirectangular panoramas).
# Get a key at https://console.anthropic.com/settings/keys
# Cost is roughly $0.19 (about Rs.17) for a full pass over a 10-scene tour,
# and it only runs when you click an AI button.
ANTHROPIC_API_KEY=

# OpenRouter is used only if ANTHROPIC_API_KEY is not set — a free fallback
# for testing the AI wiring at no cost. Expect noticeably weaker results:
# free vision models are less reliable at reading a 360° panorama, and don't
# support strict JSON-schema output, so replies are parsed leniently and can
# occasionally fail to parse.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Which OpenRouter model to use. Free vision models rotate in and out of
# availability — check https://openrouter.ai/models?max_price=0&fmt=cards for
# a current one if the default below stops working.
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# ── Google Street View publishing (optional) ─────────────────────────────
# Street View Publish uses OAuth 2.0 with per-user consent, NOT an API key:
# a tour is published to the *client's* Google Business Profile, so each
# client authorises it once and we store their refresh token.
#
# Setup, in order:
#   1. console.cloud.google.com -> new project
#   2. Enable "Street View Publish API"
#   3. OAuth consent screen -> External -> add scope:
#        https://www.googleapis.com/auth/streetviewpublish
#      (Google reviews this scope — allow days to weeks)
#   4. Credentials -> OAuth client ID -> Web application
#      Authorised redirect URI: https://YOUR_DOMAIN/auth/google/callback
#
# SECURITY: the client secret must never reach browser code — it stays in
# this file, which is gitignored. The client ID is public and safe to expose.
# If a secret is ever pasted into a chat, an email, or a commit, treat it as
# compromised and reset it in the Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:5000/auth/google/callback

# ── Server ────────────────────────────────────────────────────────────────
# Port the studio and all published tours are served from.
PORT=5000
