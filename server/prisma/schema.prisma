datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id           String   @id
  name         String
  category     String
  description  String
  location     String
  coverImage   String?
  primaryColor String
  dataJson     String   // Serialized JSON of scenes, hotspots, branding, accessibility, analytics
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
